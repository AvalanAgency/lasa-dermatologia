<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">Medicina estética · Dermatología avanzada</p>
    <h1 class="headline">Hacemos que te veas<br />como siempre quisiste.</h1>
    <p class="hero-sub">
      Un espacio en San Isidro donde la piel se trata con la precisión de la dermatología y la
      sensibilidad de quien te conoce. Botox, rellenos, láser y bioestimuladores, pensados para
      resultados naturales.
    </p>
    <div class="hero-cta">
      <a href="#contacto" class="btn btn-primary">Reservar mi turno</a>
      <a href="#tratamientos" class="btn btn-ghost">Ver tratamientos</a>
    </div>
    <div class="trust-row">
      <div class="trust-item">
        <span class="dot"></span>
        <p><b>Dermatología avanzada</b>Protocolos médicos, no de spa.</p>
      </div>
      <div class="trust-item">
        <span class="dot"></span>
        <p><b>Tecnología de punta</b>Ultherapy Prime, láser Alma.</p>
      </div>
    </div>
  </div>
  <div class="hero-media">
    <img
      src={`${import.meta.env.BASE_URL}images/hero-portrait.jpg`}
      alt="Piel luminosa y natural, el resultado que busca Lasa Dermatología"
      width="1400"
      height="2100"
    />
    <div class="hero-chip"><span class="dot"></span>San Isidro, Buenos Aires</div>
  </div>
</section>
